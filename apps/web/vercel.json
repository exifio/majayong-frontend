{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/proxy?path=:path*" },
    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ]
}
