# Local development only: MSW mock responses (never used in a production build).
VITE_USE_MOCK=true

# Public Google OAuth client ID. Keep the client secret in the backend only.
VITE_GOOGLE_CLIENT_ID=

# Staging feature flags. UI flags are not authorization; the backend enforces roles/state.
VITE_ENABLE_AGREEMENT_CONFIRM=false
VITE_ENABLE_CONTRACT_SIGN=false
VITE_ENABLE_DEPOSIT=false

# Server-side only (Vercel Function proxy). Do not prefix with VITE_.
# Example: https://staging-api.example.com (no /api/v1 suffix)
BACKEND_API_URL=
